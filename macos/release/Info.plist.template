<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>k8secret</string>
    <key>CFBundleIdentifier</key>
    <string>com.sujalsharma.k8secret</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>K8Secret</string>
    <key>CFBundleDisplayName</key>
    <string>K8Secret</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__VERSION__</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <!-- ATS stays on for the public internet: API servers and the update host are
         HTTPS. Local networking is exempted so `kubectl proxy` and local clusters
         (minikube, kind, Rancher Desktop) on http://localhost still work. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Sujal Sharma. MIT license.</string>
    <key>NSSupportsAutomaticTermination</key>
    <true/>
    <!-- Sudden termination would let macOS SIGKILL the process, skipping
         applicationWillTerminate — which is where child `kubectl port-forward`
         processes are reaped. Leaving it off keeps them from being orphaned. -->
    <key>NSSupportsSuddenTermination</key>
    <false/>
</dict>
</plist>
