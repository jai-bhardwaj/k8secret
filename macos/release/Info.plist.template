<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>k8secret</string>
    <key>CFBundleIdentifier</key>
    <string>com.sujalsharma.k8secret</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>K8Secret</string>
    <key>CFBundleDisplayName</key>
    <string>K8Secret</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__VERSION__</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <!-- App Transport Security is turned off, and the reason is specific.

         ATS applies Apple's rules for *public web* certificates to every
         connection. One of them caps a TLS server certificate's validity at 398
         days. Kubernetes cluster certificates routinely run far longer — AKS
         issues its API server a 731-day certificate — so ATS rejects them, and
         it does so after our own delegate has already verified the chain and
         approved it. What the user sees is a handshake that dies with "a TLS
         error caused the secure connection to fail" while kubectl, whose TLS
         stack has no such rule, talks to the same cluster perfectly well. It is
         also why this depended on the machine: macOS 26 enforces this where
         macOS 14 did not.

         Verification is not being given up, it is being done by K8sTLSDelegate,
         which is stricter than ATS in the ways that matter here. It pins the
         chain to the certificate-authority-data in the kubeconfig via
         SecTrustSetAnchorCertificatesOnly, so system roots cannot vouch for a
         cluster; it keeps hostname verification on with an explicit SSL policy;
         it refuses the connection outright if a configured CA cannot be parsed,
         rather than falling back; and insecure-skip-tls-verify only relaxes
         anything when the user has written it in their own kubeconfig. The TLS
         floor ATS would have enforced is set on the session directly.

         The narrower NSExceptionDomains cannot be used: the domains are the
         user's clusters, and they are not known when this file is written. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Sujal Sharma. MIT license.</string>
    <key>NSSupportsAutomaticTermination</key>
    <true/>
    <!-- Sudden termination would let macOS SIGKILL the process, skipping
         applicationWillTerminate — which is where child `kubectl port-forward`
         processes are reaped. Leaving it off keeps them from being orphaned. -->
    <key>NSSupportsSuddenTermination</key>
    <false/>
</dict>
</plist>
